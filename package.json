{
  "name": "post-it-demandas",
  "productName": "Gege Post-it",
  "version": "1.3.1",
  "description": "Gege Post-it: folhas de tarefas, recados e lembretes para a área de trabalho",
  "main": "main.js",
  "author": "Gessyca Costa",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "dependencies": {
    "electron-updater": "6.3.9",
    "koffi": "2.9.2"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "br.postit.demandas",
    "productName": "Gege Post-it",
    "artifactName": "Gege-Post-it-Setup-${version}.${ext}",
    "directories": { "buildResources": "build" },
    "files": ["index.html", "main.js", "preload.js", "package.json"],
    "asarUnpack": ["node_modules/koffi/**/*"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": [{ "provider": "github", "releaseType": "release" }]
  }
}
